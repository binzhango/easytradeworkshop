{
  "dashboardMetadata": {
    "name": "Bitcoin Payments Overview",
    "shared": true,
    "owner": "easytrade",
    "dashboardFilter": {
      "timeframe": "-2h",
      "managementZone": null
    },
    "tags": ["bitcoin", "payments", "easytrade"]
  },
  "tiles": [
    {
      "name": "Payment Request Rate",
      "tileType": "DATA_EXPLORER",
      "configured": true,
      "bounds": {
        "top": 0,
        "left": 0,
        "width": 304,
        "height": 304
      },
      "tileFilter": {},
      "customName": "Payment Requests per Minute",
      "queries": [
        {
          "id": "A",
          "metric": "builtin:service.requestCount.server",
          "spaceAggregation": "SUM",
          "timeAggregation": "DEFAULT",
          "splitBy": [],
          "filterBy": {
            "filterOperator": "AND",
            "nestedFilters": [],
            "criteria": [
              {
                "key": "dt.entity.service",
                "operator": "EQUALS",
                "value": "SERVICE-BITCOIN_PAYMENT"
              }
            ]
          },
          "rate": "MINUTE",
          "enabled": true
        }
      ],
      "visualConfig": {
        "type": "GRAPH_CHART",
        "global": {},
        "rules": [],
        "axes": {
          "xAxis": {
            "visible": true
          },
          "yAxes": []
        },
        "thresholds": []
      }
    },
    {
      "name": "Error Rate",
      "tileType": "DATA_EXPLORER",
      "configured": true,
      "bounds": {
        "top": 0,
        "left": 304,
        "width": 304,
        "height": 304
      },
      "tileFilter": {},
